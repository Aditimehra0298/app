# Global Skill Assessment — all app + LMS data in sft_lms
DATABASE_URL=mysql://root:MyNewPass123!@127.0.0.1:3306/sft_lms

# PythonAnywhere free accounts have no MySQL — use SQLite there:
# DATABASE_URL=sqlite:////home/aditimehra90/app/data/sft.sqlite
# USE_SQLITE=1

# External certificate PDF API (n8n)
CERTIFICATE_API_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook-test/certificate
# Primary email: n8n webhook (Gmail / Email node). Use /webhook/ when the workflow is Active.
CERTIFICATE_EMAIL_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook-test/7b3b463f-7a28-489a-aab1-f0938030e76d

# Public URL of THIS deployed app (required in production).
# Verify website, QR codes, PDF links, and video proofs all use this host.
PUBLIC_BASE_URL=https://YOUR-APP-HOST
VERIFY_PUBLIC_URL=https://assessment.sftlms.com

# Optional: extra browser origins allowed to call /api/certificates/verify
# VERIFY_CORS_ORIGINS=https://sftlms.com,https://www.sftlms.com

# Official SFT LMS verify page (legacy). QR codes now open THIS app's /verify.
SFTLMS_VERIFY_URL=https://sftlms.com/certificates/verify

# Same MySQL database as DATABASE_URL for Global Skill Assessment
LMS_DATABASE_URL=mysql://root:MyNewPass123!@127.0.0.1:3306/sft_lms
LMS_MYSQL_DATABASE=sft_lms

ADMIN_UID=21EUROTECH001
ADMIN_EMAIL=eurotech@gmail.com
INSTITUTE_NAME=Eurotech

# Email that receives video unlock requests from the verify website
VIDEO_ACCESS_NOTIFY_EMAIL=aditimehra0298@gmail.com

# Razorpay — $10 unlock on verify page (certificate download + training videos)
# Amount is in smallest currency unit (1000 = $10.00 USD). Use INR+85000 if USD is unavailable.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
VERIFY_UNLOCK_AMOUNT=1000
VERIFY_UNLOCK_CURRENCY=USD
VERIFY_UNLOCK_LABEL=$10
VERIFY_UNLOCK_DAYS=365

# SMTP backup only — used if n8n is down. Leave commented until you add an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your@gmail.com
