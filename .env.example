# MySQL connection
DATABASE_URL=mysql://root@127.0.0.1:3306/sft

# External certificate PDF API (no local PDF generation)
CERTIFICATE_API_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook-test/certificate


# Official SFT LMS verify page (QR codes open this with email + certificate number)
SFTLMS_VERIFY_URL=https://sftlms.com/certificates/verify

# Second MySQL — SFT LMS (same server, different database is typical).
# Ask LMS admin for user/password/database, then issued certificates sync into sft_trade_certificates.
LMS_DATABASE_URL=mysql://root@127.0.0.1:3306/sft_lms
LMS_MYSQL_DATABASE=sft_lms

# Public URL of THIS app so sftlms.com can load PDFs and video proofs
# PUBLIC_BASE_URL=https://your-app-host.example.com

ADMIN_UID=21Admin2021
ADMIN_EMAIL=sft@admin.com
